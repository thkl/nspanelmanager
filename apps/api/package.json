{
  "name": "@nspanel/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -v APP_PUBLIC_URL=http://localhost:4200 -v DATA_DIR=./data -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:debug": "dotenv -e ../../.env -v DATA_DIR=./data -- tsx watch src/server.ts",
    "security:keygen": "node --experimental-strip-types src/features/security/create-encryption-key.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "express": "^5.1.0",
    "mqtt": "^5.14.1",
    "openid-client": "^6.8.8",
    "quickjs-emscripten": "^0.32.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
