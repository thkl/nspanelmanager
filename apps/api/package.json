{
  "name": "@nspanel/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -v APP_PUBLIC_URL=http://localhost:4200 -v DATA_DIR=./data -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:debug": "dotenv -e ../../.env -v DATA_DIR=./data -- tsx watch --inspect src/server.ts",
    "security:keygen": "node --experimental-strip-types src/features/security/create-encryption-key.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "archiver": "^8.0.0",
    "express": "^5.3.0",
    "mqtt": "^5.16.1",
    "openid-client": "^6.8.8",
    "quickjs-emscripten": "^0.32.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
