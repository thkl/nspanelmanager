{
  "name": "nspanel-manager",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "start:debug": "pnpm --filter @nspanel/web build && pnpm --filter @nspanel/api start:debug",
    "dev": "pnpm --parallel --filter @nspanel/api --filter @nspanel/web dev",
    "build": "pnpm --filter @nspanel/web build && pnpm --filter @nspanel/api build",
    "firmware:compile": "node scripts/compile-panel5.mjs",
    "security:keygen": "pnpm --filter @nspanel/api security:keygen"
  }
}
