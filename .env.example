# Docker Compose settings for NSPanel Manager.
# Copy this file to .env and edit it for your deployment.

# Public origin used by the API for same-origin checks and secure auth cookies.
# Update this when accessing the manager through a reverse proxy or domain.
# For `pnpm start:debug` and Docker Compose, use the origin serving the built app.
# `pnpm dev` serves Angular at port 4200 and sets that origin for the API automatically.
APP_PUBLIC_URL=http://localhost:3000

# Express trusted reverse proxy setting. Defaults to false (socket peer only).
# Prefer the exact Traefik IP/CIDR or proxy subnet, for example 172.20.0.0/16.
# Comma-separated IPs/CIDRs and Express subnet names are supported. `true` or a
# hop count requires a fixed proxy path, overwritten forwarded headers, and no direct API access.
TRUST_PROXY=false

# Absolute data directory inside the Docker container. The manager-data volume
# is mounted here; local development keeps its data under apps/api/data.
DATA_DIR=/data

# Rotating application logs. Defaults to ${DATA_DIR}/logs on the same volume.
# If set, choose a writable persistent directory and back it up separately.
# LOG_DIR=

# Local API runs read this file. Docker Compose mounts the same host secret at
# /run/secrets/manager_encryption_key inside the container.
MANAGER_ENCRYPTION_KEY_FILE=../../secrets/manager_encryption_key

# Optional OIDC / SSO settings. To enable SSO:
# 1. Change APP_PUBLIC_URL above to your public HTTPS origin and set these values.
# 2. Create secrets/oidc_client_secret with the provider's client secret.
# 3. Start with docker-compose.sso.yml as documented in README.md.
# Register `${APP_PUBLIC_URL}/api/auth/sso/callback` with your identity provider.
# OIDC_ISSUER_URL=https://login.example.com/application/o/nspanel/
# OIDC_CLIENT_ID=nspanel-manager

# Do not put the OIDC client secret in this file. It is mounted as a Compose secret.
# For a direct local API run (`pnpm start:debug`), set this to the host file path
# relative to apps/api. The Docker SSO override sets the container path itself.
# OIDC_CLIENT_SECRET_FILE=../../secrets/oidc_client_secret
OIDC_ISSUER_URL= 
OIDC_CLIENT_ID= 
